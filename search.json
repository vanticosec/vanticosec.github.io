---
layout: null
permalink: /search.json
---
{%- assign docs = site.posts | concat: site.wiki -%}
[
{%- for d in docs -%}
  {
    "title": {{ d.title | jsonify }},
    "url": {{ d.url | relative_url | jsonify }},
    "kind": {% if d.collection == 'wiki' %}"Wiki"{% else %}"Artigo"{% endif %},
    "text": {{ d.content | strip_html | normalize_whitespace | truncatewords: 400 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
